# ============================================================
# KHUDA 10기 토이프로젝트 3조 — Git 제외 목록
#
# 방식: "일단 전부 막고, 올리기로 정한 것만 다시 연다"
#
# 왜 이렇게 하냐면 — 목록에 없는 파일이 실수로 올라가는 사고를
# 구조적으로 막기 위해서입니다. API 키 엑셀이나 가상환경처럼
# 미처 생각 못 한 파일도 자동으로 걸립니다.
#
# 새 확장자를 올리고 싶으면 아래 [2] 구역에 한 줄만 추가하세요.
# ============================================================


# ── [1] 전부 막기 ───────────────────────────────────────────
*

# 폴더는 열어둡니다. 이게 없으면 하위 폴더 안을 아예 못 봅니다
!*/


# ── [2] 올릴 파일 — 새 형식은 여기에 추가 ───────────────────
!*.py
!*.pdf
!*.docx
!*.ipynb

# 문서 · 설정
!*.md
!*.txt
!.gitignore
!.gitattributes

# 데이터는 압축본만 (원본 csv는 [3]에서 막습니다)
!*.csv.gz

# 보고서 부속 파일
!*.html
!*.json
!reports/**/*.csv
!데이터명세서.xlsx

!*.png
!*.ps1

# 필요해지면 아래 # 를 지우세요
# !*.pptx


# ── [3] [2]에 해당해도 무조건 막을 것 ───────────────────────
# 인증 정보 — .py 지만 절대 올리면 안 됨
secret.py
.env
.env.*
*API_Key*
*api_key*

# 가상환경 — chanjin 브랜치에 1만 개가 올라간 원인
.venv/
venv/
env/
ENV/
.conda/

# 압축 파일 — GitHub에서 내용을 열람·리뷰할 수 없고,
# 큰 파일은 LFS 할당량(조직 전체가 공유)을 잠식합니다.
# 코드와 보고서는 압축하지 말고 src/N_단계 · reports/N_단계에 그대로 넣어주세요.
*.zip
*.7z
*.rar
*.tar
*.tar.gz

# 파이썬 부산물
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# 압축하지 않은 대용량 CSV — 반드시 .csv.gz 로 올릴 것
*.csv
!reports/**/*.csv

# 예외: 시장확률보정 파이프라인은 자체 완결 구조라 부속 파일을 함께 둡니다
!src/3_시장대조/시장확률보정/**/*.csv
!src/3_시장대조/시장확률보정/**/*.joblib

# 로컬 원본 데이터 폴더 (586MB · 214MB)
# 앞의 / 는 "저장소 최상위에서만"이라는 뜻입니다.
# 이게 없으면 하위 폴더의 raw/ 까지 전부 막힙니다.
/raw/
/prep/

# 실행하면 생기는 산출물 폴더 (저장소에 올리지 않습니다)
/results/
/data/versions/
/data/splits/

# 진행 상태 · 로그
.checkpoint.json
collect_log.csv


# ============================================================
# 한 번만 예외로 올리고 싶을 때
#
#   git add -f 데이터명세서.xlsx
#
# -f 는 "규칙 무시하고 강제로"라는 뜻입니다.
# 이 파일을 고치지 않고도 특정 파일 하나만 올릴 수 있습니다.
# ============================================================
