# ============================================================
# KHUDA 10기 토이프로젝트 3조 — Git 제외 목록
#
# 방식: "일단 전부 막고, 올리기로 정한 것만 다시 연다"
#
# 왜 이렇게 하냐면 — 목록에 없는 파일이 실수로 올라가는 사고를
# 구조적으로 막기 위해서입니다. API 키 엑셀이나 가상환경처럼
# 미처 생각 못 한 파일도 자동으로 걸립니다.
#
# 새 확장자를 올리고 싶으면 아래 [2] 구역에 한 줄만 추가하세요.
# ============================================================


# ── [1] 전부 막기 ───────────────────────────────────────────
*

# 폴더는 열어둡니다. 이게 없으면 하위 폴더 안을 아예 못 봅니다
!*/


# ── [2] 올릴 파일 — 새 형식은 여기에 추가 ───────────────────
!*.py
!*.pdf
!*.docx

# 문서 · 설정
!*.md
!requirements.txt
!.gitignore
!.gitattributes

# 필요해지면 아래 # 를 지우세요
# !*.csv.gz      압축한 데이터 (원본 csv 대신 이걸 올릴 것)
# !*.png         그래프 이미지
# !*.html        리포트
# !*.ipynb       주피터 노트북 (올리기 전 출력은 지울 것)
# !*.json
# !*.pptx


# ── [3] [2]에 해당해도 무조건 막을 것 ───────────────────────
# 인증 정보 — .py 지만 절대 올리면 안 됨
secret.py
.env
.env.*
*API_Key*
*api_key*

# 가상환경 — chanjin 브랜치에 1만 개가 올라간 원인
.venv/
venv/
env/
ENV/
.conda/

# 파이썬 부산물
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# 대용량 원본 (raw/ 586MB · data/ 214MB)
raw/
data/

# 진행 상태 · 로그
.checkpoint.json
collect_log.csv


# ============================================================
# 한 번만 예외로 올리고 싶을 때
#
#   git add -f 데이터명세서.xlsx
#
# -f 는 "규칙 무시하고 강제로"라는 뜻입니다.
# 이 파일을 고치지 않고도 특정 파일 하나만 올릴 수 있습니다.
# ============================================================
